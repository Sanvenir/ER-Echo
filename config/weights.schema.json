{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-echo.local/weights.schema.json",
  "title": "ER Echo combat-director weights",
  "description": "LLM 每 tick 输出的一包行为权重。所有值 0-1，未列出的维度保持不变。",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "seq", "weights"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggression":     { "type": "number", "minimum": 0, "maximum": 1 },
        "dodge_rate":     { "type": "number", "minimum": 0, "maximum": 1 },
        "guard_rate":     { "type": "number", "minimum": 0, "maximum": 1 },
        "combo_rate":     { "type": "number", "minimum": 0, "maximum": 1 },
        "heal_priority":  { "type": "number", "minimum": 0, "maximum": 1 },
        "spell_rate":     { "type": "number", "minimum": 0, "maximum": 1 },
        "item_rate":      { "type": "number", "minimum": 0, "maximum": 1 },
        "spacing":        { "type": "number", "minimum": 0, "maximum": 1 },
        "target_switch":  { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "strategy": {
      "enum": ["hold_line", "pressure", "kite", "burst", "protect", "retreat", "observe"]
    },
    "loadout": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "weapon_right": { "type": "integer", "minimum": 0 },
        "weapon_left":  { "type": "integer", "minimum": 0 },
        "head":         { "type": "integer", "minimum": 0 },
        "body":         { "type": "integer", "minimum": 0 },
        "hands":        { "type": "integer", "minimum": 0 },
        "legs":         { "type": "integer", "minimum": 0 }
      }
    },
    "say": { "type": "string", "maxLength": 40 },
    "reason": { "type": "string", "maxLength": 120 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
